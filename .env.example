# CancerCare Zimbabwe Environment Configuration
# Real secrets must be provided via environment variables at runtime.

# Node environment
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# === Server Configuration ===
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000

# === Database Configuration ===
# SQLite path (relative to project root)
DB_PATH=./cancercare.db

# === Authentication ===
# WARNING: Change this to a strong secret before production!
JWT_SECRET=replace-with-a-strong-secret-at-least-32-chars-long
RESET_SECRET=replace-with-a-strong-reset-secret-at-least-32-chars-long

# === AI Integration (Optional, Server-Side Only) ===
# Gemini API key -- server-side only, never exposed to browser
# When not configured, AI chat uses local fallback with disclaimer.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
AI_PROVIDER=gemini

# === OpenStreetMap / Maps ===
# OpenStreetMap requires no API keys for basic usage
OPENLEAFLET_ENABLED=true

# === Optional Email / SMS ===
EMAIL_FROM=no-reply@cancercarezim.co.zw
SMS_ENABLED=false
SMS_PROVIDER_URL=
SMS_API_KEY=

# === Rate Limiting ===
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# === File Uploads ===
MAX_FILE_SIZE=5242880

# === Symptom Recognition Service (Internal Python) ===
SYMPTOM_SERVICE_URL=http://127.0.0.1:5001
SYMPTOM_SERVICE_ENABLED=true
MAX_ARTICLE_WORDS=5000
